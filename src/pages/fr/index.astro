---
import HomeLayout from "../../layouts/HomeLayout.astro";
import { getEntry, render } from "astro:content";

// Get home page content (French)
const entry = await getEntry("pages", "fr/home");
if (!entry) {
  throw new Error("French home page content not found");
}
const { Content } = await render(entry);

// Get English home page content for image fallback
const enEntry = await getEntry("pages", "en/home");
const heroImage =
  entry.data.image || enEntry?.data.image || "/images/site/home-hero.jpg";

---

<HomeLayout title="Accueil" heroImage={heroImage}>
  <div class="home-internal-content">
    <div class="home-main-content">
      <div class="upcoming-announcement">
        <p class="announcement-date">Vendredi 6 novembre à 19h à La Loingtaine</p>
        <h3 class="announcement-title">Les Violons de Bruxelles</h3>
        <p class="musician-info">avec Tcha Limberger, violon et chant.</p>
      </div>

      <div class="section-intro">
        <div class="content-body">
          <Content />
        </div>
      </div>

      <div class="action-buttons">
        <a href="/fr/delight/upcoming-concerts/" class="btn-main"
          >cliquez pour le programme des concerts</a
        >
        <a href="https://music-academy.laloingtaine.org/" class="btn-main"
          >Découvrir les professeurs de l'Académie d'été</a
        >
      </div>
    </div>

    <!-- About Sub-navigation -->
    <nav class="about-subnav">
      <a href="/fr/about/history/">La Loingtaine</a>
      <a href="/fr/about/why-new-site/">Pourquoi ce nouveau site?</a>
      <a href="/fr/about/who-are-we/">Qui sommes-nous?</a>
      <a href="/fr/about/calendar/">Calendrier</a>
      <a href="/fr/about/how-to-get-there/">Comment y aller?</a>
    </nav>
  </div>
</HomeLayout>

<style>
  .home-internal-content {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100%;
    flex: 1;
  }

  .home-main-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .home-internal-content .content-body {
    text-align: center;
  }

  .upcoming-announcement {
    margin-bottom: 40px;
    text-align: center;
  }

  .announcement-date {
    color: #8b1e1e;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 5px;
  }

  .announcement-title {
    font-family: "Playfair Display", serif;
    font-size: 1.6rem;
    color: #4a3728;
    margin-bottom: 10px;
  }

  .musician-info {
    font-size: 0.95rem;
    color: #666;
    margin-bottom: 2px;
  }
  /* ... otros estilos ... */

  .home-internal-content .content-body :global(p) {
    margin-bottom: 1.5rem; /* Espacio entre párrafos */
    line-height: 1.4; /* Ajusta este número a tu gusto (ej: 1.4, 1.6, 1.8) */
  }
  .action-buttons {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 40px;
  }

  .btn-main {
    background: #8b1e1e;
    color: white;
    text-decoration: none;
    padding: 12px 25px;
    border-radius: 4px;
    font-family: "Roboto", sans-serif;
    font-size: 0.9rem;
    text-transform: lowercase;
    transition: background 0.2s;
  }

  .btn-main:hover {
    background: #4a3728;
  }

  .about-subnav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px 25px;
    margin-top: 20px;
    flex-shrink: 0;
  }

  .about-subnav a {
    color: #8b1e1e;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .about-subnav a:hover {
    color: #4a3728;
    text-decoration: underline;
  }
</style>
